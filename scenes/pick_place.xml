<mujoco model="ur5e scene">
 <include file="../universal_robots_ur5e/ur5e.xml"/>

  <compiler meshdir="../universal_robots_ur5e/assets"/>
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
             markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>

    <!-- ========== 新增：场景材质定义 ========== -->
    <material name="mat_table" rgba="0.7 0.7 0.7 1"/>
    <material name="mat_tray" rgba="0.3 0.5 0.8 1"/>
    <material name="mat_block" rgba="0.9 0.2 0.2 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" pos="0 0 -0.71" size="0 0 0.05" type="plane" material="groundplane"/>

       <!-- 工作台：总宽1m(x) × 总长0.9m(y) × 高0.7m，台面与基座底面齐平(z=0) -->
    <!-- 中心位置(0, 0.15, -0.35)：后半部分容纳基座，前半部分留足操作空间 -->
    <body name="workbench" pos="0 0.15 -0.35">
      <geom type="box" size="0.5 0.45 0.35" material="mat_table" solimp="0.9 0.95 0.01"/>
    </body>

    <!-- 上料区：左前方，距离基座0.4m，完全在台面上 -->
    <body name="feed_tray" pos="-0.35 0.4 0.005">
      <geom type="box" size="0.1 0.1 0.005" material="mat_tray"/>
    </body>

    <!-- 下料区：右前方，与上料区对称 -->
    <body name="place_tray" pos="0.35 0.4 0.005">
      <geom type="box" size="0.1 0.1 0.005" material="mat_tray"/>
    </body>

    <!-- 待搬运方块：同步移到上料区中心 -->
    <body name="workpiece" pos="-0.35 0.4 0.035">
      <freejoint/>
      <geom type="box" size="0.025 0.025 0.025" material="mat_block" mass="0.1" solimp="0.8 0.9 0.01"/>
    </body>


  </worldbody>
  <!-- 初始归位姿态：大臂抬起，末端朝向工作台前方 -->
  <keyframe>
    <key name="home_pose" qpos="0 -1.2 1.8 0 0.8 0 -0.35 0.4 0.035 1 0 0 0"/>
  </keyframe>

  <!-- ========== 抓取控制接口 ========== -->
  <equality>
    <!-- 焊接约束：绑定工件与末端法兰 wrist_3_link -->
    <!-- active="false" 默认松开，true 为抓取状态 -->
    <weld name="grip_constraint"
          body1="workpiece"
          body2="wrist_3_link"
          active="false"
          solref="0.02 1"/>
  </equality>


</mujoco>
